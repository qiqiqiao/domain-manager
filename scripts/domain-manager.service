[Unit]
Description=Domain Manager - Domain and SSL Certificate Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=domain-manager
Group=domain-manager
WorkingDirectory=/opt/domain-manager
ExecStart=/opt/domain-manager/domain-manager
Restart=always
RestartSec=5
LimitNOFILE=65536
# 若通过环境变量配置：
# Environment=DM_PORT=10120
# Environment=DM_COOKIE_SECURE=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/domain-manager/data /opt/domain-manager/logs /opt/domain-manager/configs
ProtectHome=true
# 允许非 root 进程绑定 80 端口，供 ACME HTTP-01 Standalone 使用
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
